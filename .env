PORT=5000

# Emotion Detection (TED/SED) - Optional
# TED_API_URL=https://example-ted-api.com/process
# SED_API_URL=https://example-sed-api.com/process
# TED_API_KEY=your-ted-api-key
# SED_API_KEY=your-sed-api-key

# AI Content Generation Service
# Options: ollama (local), openai, huggingface
AI_PROVIDER=ollama

# For Ollama (Local AI - default)
AI_ENDPOINT=http://localhost:11434/api/generate
AI_MODEL=mistral

# For OpenAI
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-openai-key

# For Hugging Face
# AI_PROVIDER=huggingface
# AI_MODEL=mistralai/Mistral-7B-Instruct-v0.1
# AI_API_KEY=hf_your-huggingface-key